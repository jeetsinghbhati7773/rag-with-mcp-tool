# ==========================================
# 🧠 AI Knowledge Assistant - Environment Variables
# ==========================================

# Groq API Key (Required for LLM assistant)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# PostgreSQL 18 Database URL (Psycopg 3 Driver)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/ai_knowledge_assistant

# FastMCP Server URL (Optional: for remote MCP expense tools server)
FASTMCP_URL=https://splendid-gold-dingo.fastmcp.app/mcp

# Alpha Vantage API Key (Optional: for real-time stock price lookup)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Embeddings & RAG Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=5
MCP_TIMEOUT=15

# LangChain Tracing & Observability (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=ai-knowledge-assistant

# Application Access Code (Required to continue when app is loaded)
APP_ACCESS_CODE=1234
